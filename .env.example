PORT=3001
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/fonoaudioplay.sqlite
RECORDINGS_DIR=./data/recordings

# Set a valid credential path or FIREBASE_SERVICE_ACCOUNT_JSON in the server environment.
# GOOGLE_APPLICATION_CREDENTIALS=

# Optional: without this key, speech transcription returns a clear service-unavailable response.
OPENAI_API_KEY=

# Frontend Firebase configuration. Leave empty to use the local demo dashboard.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
